[{"s": 0.0, "e": 14.3, "t": "Swap the Moon for one planet, and you could see a canyon on it longer than the Moon is wide. Swap it for another, and the ocean would rise and fall thirty meters, twice a day. And swap it for the biggest one... and Earth isn't the planet anymore. Earth is the moon.", "w": [["swap", 0.0], ["the", 0.41], ["moon", 0.51], ["for", 0.75], ["one", 0.89], ["planet", 1.26], ["and", 1.81], ["you", 2.01], ["could", 2.12], ["see", 2.23], ["a", 2.4], ["canyon", 2.46], ["on", 2.99], ["it", 3.12], ["longer", 3.22], ["than", 3.72], ["the", 3.82], ["moon", 3.89], ["is", 4.2], ["wide", 4.33], ["swap", 5.03], ["it", 5.3], ["for", 5.38], ["another", 5.55], ["and", 5.98], ["the", 6.34], ["ocean", 6.47], ["would", 6.82], ["rise", 6.94], ["and", 7.38], ["fall", 7.47], ["thirty", 7.76], ["meters", 8.23], ["twice", 8.71], ["a", 9.19], ["day", 9.25], ["and", 9.64], ["swap", 9.9], ["it", 10.17], ["for", 10.25], ["the", 10.34], ["biggest", 10.43], ["one", 10.88], ["and", 11.34], ["earth", 11.59], ["isn't", 11.83], ["the", 12.1], ["planet", 12.18], ["anymore", 12.59], ["earth", 13.21], ["is", 13.51], ["the", 13.7], ["moon", 13.79]]}, {"s": 15.19, "e": 22.97, "t": "So let's take every planet, put it exactly where the Moon is, and see what happens to you. From the smallest... to the one that steals our planet.", "w": [["so", 15.19], ["let's", 15.34], ["take", 15.58], ["every", 15.89], ["planet", 16.28], ["put", 16.76], ["it", 17.08], ["exactly", 17.22], ["where", 17.9], ["the", 18.05], ["moon", 18.13], ["is", 18.39], ["and", 18.82], ["see", 18.96], ["what", 19.19], ["happens", 19.35], ["to", 19.74], ["you", 19.88], ["from", 20.21], ["the", 20.38], ["smallest", 20.44], ["to", 21.23], ["the", 21.35], ["one", 21.43], ["that", 21.73], ["steals", 21.87], ["our", 22.37], ["planet", 22.5]]}, {"s": 23.41, "e": 30.29, "t": "Ceres. The biggest thing in the asteroid belt, and the smallest world on our list. It's almost four times narrower than the Moon.", "w": [["ceres", 23.41],